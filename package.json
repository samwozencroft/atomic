{
  "name": "atomic",
  "version": "1.0.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/samwozencroft/atomic.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --publish never"
  },
  "build": {
    "appId": "com.atom.reborn",
    "productName": "Atomic",
    "publish": [
      "github"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ]
    }
  },
  "keywords": [],
  "author": {
    "name": "Samuel Wozencroft",
    "email": "samuelwozencroft@outlook.com"
  },
  "license": "ISC",
  "description": "A lightweight, modern text editor built on Electron 30 and Node 20.",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.55.1"
  }
}
